{
  "name": "datalaw_recnik",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "datalaw_recnik — сербско-русский словарь для Android (онлайн + офлайн) (Capacitor + Preact + Vite)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:data": "python3 scripts/test_build_data.py",
    "check": "npm run typecheck && npm test && npm run test:data",
    "data:sample": "python3 scripts/build_data.py --sample",
    "data:build": "python3 scripts/build_data.py --download --require-wordfreq",
    "assets": "python3 scripts/android_icons.py",
    "cap:add": "cap add android",
    "cap:sync": "npm run build && cap sync android && node scripts/android-patch.mjs",
    "android:open": "npm run cap:sync && cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "android:release": "bash scripts/release-apk.sh",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
